# Beryl AX Pineapple - Environment Configuration

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=production  # development, staging, production

# =============================================================================
# Security & Authentication
# =============================================================================
SECRET_KEY=CHANGE_THIS_TO_RANDOM_STRING_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Key for router-to-server communication
ROUTER_API_KEY=CHANGE_THIS_SECURE_API_KEY

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL (production)
DATABASE_URL=postgresql://beryl_user:secure_password@localhost:5432/beryl_db

# SQLite (development/testing)
# DATABASE_URL=sqlite:///./beryl.db

# Database pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =============================================================================
# Router Configuration
# =============================================================================
ROUTER_HOST=192.168.8.1
ROUTER_PORT=22
ROUTER_USER=root
ROUTER_SSH_KEY_PATH=/home/user/.ssh/router_key

# Router connection timeout (seconds)
ROUTER_TIMEOUT=30

# =============================================================================
# MCP Server Configuration
# =============================================================================
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_ENABLED=true

# =============================================================================
# Storage & PCAP Configuration
# =============================================================================
# Local storage for received PCAPs
PCAP_STORAGE_PATH=/var/lib/beryl/pcaps
MAX_PCAP_SIZE_MB=100
PCAP_RETENTION_DAYS=30

# Log storage
LOG_PATH=/var/log/beryl
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# Security Tool Configuration
# =============================================================================
# Maximum concurrent scans
MAX_CONCURRENT_SCANS=3

# Default tool timeouts (seconds)
NMAP_TIMEOUT=300
GOBUSTER_TIMEOUT=600
NIKTO_TIMEOUT=900

# Tool paths (if not in PATH)
# NMAP_PATH=/usr/bin/nmap
# GOBUSTER_PATH=/usr/bin/gobuster

# =============================================================================
# AI Integration (Optional)
# =============================================================================
# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API (if using)
# OPENAI_API_KEY=sk-...

# AI analysis enabled
AI_ANALYSIS_ENABLED=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# Monitoring & Observability
# =============================================================================
# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Sentry error tracking (optional)
# SENTRY_DSN=https://...@sentry.io/...

# =============================================================================
# Email Notifications (Optional)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=secure_password
SMTP_FROM=beryl-alerts@example.com

# Alert recipients (comma-separated)
ALERT_RECIPIENTS=admin@example.com

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_WIRELESS_SCANNING=true
ENABLE_PACKET_CAPTURE=true
ENABLE_ACTIVE_SCANNING=false  # Requires explicit ethical approval
ENABLE_CAPTIVE_PORTAL=false

# =============================================================================
# Resource Limits
# =============================================================================
# Maximum memory per scan process (MB)
MAX_MEMORY_MB=512

# Maximum CPU cores for scanning
MAX_CPU_CORES=2

# Maximum upload size (MB)
MAX_UPLOAD_SIZE_MB=50

# =============================================================================
# Development & Testing
# =============================================================================
# Reload server on code changes (development only)
RELOAD=false

# Mock router connections (testing)
MOCK_ROUTER=false

# Test mode (disables dangerous operations)
TEST_MODE=false
