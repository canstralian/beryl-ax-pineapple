# Beryl AX Pineapple - FastAPI Server Dockerfile

FROM python:3.11-slim

LABEL maintainer="Beryl AX Pineapple Team"
LABEL description="FastAPI REST API server for security automation"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tcpdump \
    tshark \
    ssh \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create app user (don't run as root)
RUN useradd -m -u 1000 -s /bin/bash appuser && \
    mkdir -p /app/data/pcaps /app/logs && \
    chown -R appuser:appuser /app

# Copy requirements first (for layer caching)
COPY pyproject.toml /app/

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -e ".[ai,monitoring]"

# Copy application code
COPY src/ /app/src/

# Set ownership
RUN chown -R appuser:appuser /app

# Switch to app user
USER appuser

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run FastAPI server
CMD ["uvicorn", "remote_host.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
