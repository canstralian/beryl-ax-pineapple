# Beryl AX Pineapple - MCP Server Dockerfile

FROM python:3.11-slim

LABEL maintainer="Beryl AX Pineapple Team"
LABEL description="Model Context Protocol server for AI integration"

WORKDIR /app

# Install minimal dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m -u 1000 -s /bin/bash appuser && \
    chown -R appuser:appuser /app

# Copy requirements
COPY pyproject.toml /app/

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e ".[ai]"

# Copy application code
COPY src/ /app/src/

# Set ownership
RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 9000

# Run MCP server
CMD ["python", "-m", "remote_host.mcp_server"]
