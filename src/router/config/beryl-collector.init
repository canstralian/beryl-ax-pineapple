#!/bin/sh /etc/rc.common

################################################################################
# OpenWrt Init Script for Beryl AX Pineapple Telemetry Collector
#
# Manages the Lua telemetry collector as a system service.
# Optimized for GL.iNet Beryl AX (MT-3000) with resource constraints.
#
# Installation:
#   cp beryl-collector.init /etc/init.d/beryl-collector
#   chmod +x /etc/init.d/beryl-collector
#   /etc/init.d/beryl-collector enable
#   /etc/init.d/beryl-collector start
#
# Configuration:
#   UCI configuration at /etc/config/beryl-mcp
################################################################################

START=99
STOP=10

USE_PROCD=1
PROG=/usr/local/lib/lua/telemetry_collector.lua
NAME=beryl-collector
PIDFILE=/var/run/$NAME.pid

################################################################################
# Helper Functions
################################################################################

# Load configuration from UCI
load_config() {
    config_load beryl-mcp

    # Read configuration values
    config_get REMOTE_HOST collector remote_host "192.168.1.100"
    config_get REMOTE_PORT collector remote_port "8000"
    config_get API_KEY collector api_key "CHANGE_THIS_SECURE_API_KEY"
    config_get MONITOR_INTERFACE collector monitor_interface "wlan0"
    config_get SCAN_INTERVAL collector scan_interval "10"
    config_get_bool ENABLED collector enabled 1

    # Export as environment variables for Lua script
    export BERYL_REMOTE_HOST="$REMOTE_HOST"
    export BERYL_REMOTE_PORT="$REMOTE_PORT"
    export BERYL_API_KEY="$API_KEY"
}

# Validate configuration
validate_config() {
    # Check if Lua script exists
    if [ ! -f "$PROG" ]; then
        logger -t "$NAME" -p err "Collector script not found: $PROG"
        return 1
    fi

    # Check if required packages are installed
    if ! command -v lua >/dev/null 2>&1; then
        logger -t "$NAME" -p err "Lua not installed (opkg install lua)"
        return 1
    fi

    # Check if API key is set
    if [ "$API_KEY" = "CHANGE_THIS_SECURE_API_KEY" ]; then
        logger -t "$NAME" -p warning "Default API key detected - please configure secure key"
    fi

    return 0
}

# Check resource availability
check_resources() {
    # Check available memory
    local mem_avail=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
    if [ "$mem_avail" -lt 20480 ]; then  # 20MB minimum
        logger -t "$NAME" -p warning "Low memory available: ${mem_avail}KB"
    fi

    # Check if interface exists
    if [ -n "$MONITOR_INTERFACE" ] && ! ip link show "$MONITOR_INTERFACE" >/dev/null 2>&1; then
        logger -t "$NAME" -p warning "Monitor interface not found: $MONITOR_INTERFACE"
    fi
}

################################################################################
# Service Management (procd)
################################################################################

start_service() {
    # Load configuration
    load_config

    # Check if enabled
    if [ "$ENABLED" -ne 1 ]; then
        logger -t "$NAME" -p info "Service disabled in configuration"
        return 0
    fi

    # Validate configuration
    if ! validate_config; then
        return 1
    fi

    # Check resources
    check_resources

    logger -t "$NAME" -p info "Starting telemetry collector (interface: $MONITOR_INTERFACE)"

    # Create temp directory
    mkdir -p /tmp/beryl-telemetry

    # Start service using procd
    procd_open_instance

    # Set command
    procd_set_param command /usr/bin/lua "$PROG"

    # Set process attributes
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}

    # Stdout/stderr to syslog
    procd_set_param stdout 1
    procd_set_param stderr 1

    # Set nice level (lower priority to preserve resources)
    procd_set_param nice 10

    # Set resource limits
    # Limit to 50MB memory (prevents OOM on low-memory device)
    procd_set_param limits core="0 0" nofile="1024 1024" as="52428800 52428800"

    # Set environment
    procd_set_param env BERYL_REMOTE_HOST="$REMOTE_HOST"
    procd_set_param env BERYL_REMOTE_PORT="$REMOTE_PORT"
    procd_set_param env BERYL_API_KEY="$API_KEY"

    # Termination timeout
    procd_set_param term_timeout 10

    procd_close_instance
}

stop_service() {
    logger -t "$NAME" -p info "Stopping telemetry collector"

    # procd handles stopping automatically
}

service_triggers() {
    # Reload on network changes
    procd_add_reload_trigger "network" "beryl-mcp"
}

reload_service() {
    logger -t "$NAME" -p info "Reloading configuration"

    # Stop and start to reload config
    stop
    start
}

################################################################################
# Status Check
################################################################################

status() {
    # Check if process is running
    if [ -f "$PIDFILE" ]; then
        local pid=$(cat "$PIDFILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "Beryl collector is running (PID: $pid)"

            # Show resource usage
            if [ -f "/proc/$pid/status" ]; then
                local mem_kb=$(awk '/VmRSS/ {print $2}' "/proc/$pid/status")
                echo "Memory usage: ${mem_kb}KB (~$((mem_kb/1024))MB)"
            fi

            return 0
        else
            echo "Beryl collector is not running (stale PID file)"
            return 1
        fi
    else
        echo "Beryl collector is not running"
        return 3
    fi
}

################################################################################
# Additional Commands
################################################################################

# Show configuration
show_config() {
    load_config

    echo "Beryl AX Pineapple Configuration"
    echo "================================"
    echo "Remote Host: $REMOTE_HOST:$REMOTE_PORT"
    echo "Monitor Interface: $MONITOR_INTERFACE"
    echo "Scan Interval: ${SCAN_INTERVAL}s"
    echo "Enabled: $ENABLED"
    echo "API Key: $(echo "$API_KEY" | cut -c1-8)..."
}

# Test connectivity to remote host
test_connection() {
    load_config

    echo "Testing connection to remote host..."
    echo "Host: $REMOTE_HOST:$REMOTE_PORT"

    # Test network connectivity
    if ping -c 1 -W 2 "$REMOTE_HOST" >/dev/null 2>&1; then
        echo "✓ Network reachable"
    else
        echo "✗ Network unreachable"
        return 1
    fi

    # Test API endpoint
    if curl -s -m 5 "http://${REMOTE_HOST}:${REMOTE_PORT}/health" >/dev/null 2>&1; then
        echo "✓ API endpoint accessible"
    else
        echo "✗ API endpoint not accessible"
        return 1
    fi

    echo "Connection test passed!"
}

################################################################################
# Custom Commands
################################################################################

EXTRA_COMMANDS="status show_config test_connection"
EXTRA_HELP="        status          Show service status and resource usage
        show_config     Display current configuration
        test_connection Test connectivity to remote host"
